<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="bff_expiry_control.ProductCard" t-inherit="point_of_sale.ProductCard" t-inherit-mode="extension">
        <xpath expr="//article" position="inside">
            <t t-if="props.product">
                <t t-if="props.product.expiry_level === 'danger' || (props.product.is_near_expiry &amp;&amp; props.product.days_to_expiry &lt;= 7)">
                    <div class="pos-expiry-badge danger" t-attf-title="Exp: {{props.product.earliest_expiry_date || '-'}}">
                        🔥 🔴 Obral (<t t-esc="props.product.days_to_expiry &lt;= 0 ? 'Expired' : (props.product.days_to_expiry + 'H')"/>)
                    </div>
                </t>
                <t t-elif="props.product.expiry_level === 'warning' || (props.product.is_near_expiry &amp;&amp; props.product.days_to_expiry &lt;= 30)">
                    <div class="pos-expiry-badge warning" t-attf-title="Exp: {{props.product.earliest_expiry_date || '-'}}">
                        ⚠️ 🟡 Exp <t t-esc="props.product.days_to_expiry"/>H
                    </div>
                </t>
                <t t-elif="props.product.earliest_expiry_date &amp;&amp; props.product.expiry_level === 'safe'">
                    <div class="pos-expiry-badge safe" t-attf-title="Exp: {{props.product.earliest_expiry_date || '-'}}">
                        ✅ 🟢 Segar
                    </div>
                </t>
            </t>
        </xpath>
    </t>
</templates>
