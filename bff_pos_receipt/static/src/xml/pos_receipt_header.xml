<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="bff_pos_receipt.ReceiptHeader" t-inherit="point_of_sale.ReceiptHeader" t-inherit-mode="extension">

        <!-- Replace logo with controlled wrapper -->
        <xpath expr="//img[hasclass('pos-receipt-logo')]" position="replace">
            <t t-if="props.data and props.data.company and props.data.company.id">
                <img t-attf-src="/web/image?model=res.company&amp;id={{props.data.company.id}}&amp;field=logo"
                     alt="Logo" class="bff-logo"/>
            </t>
        </xpath>

        <!-- Replace contact block entirely -->
        <xpath expr="//div[hasclass('pos-receipt-contact')]" position="replace">
            <div class="bff-header" t-if="props.data">
                <!-- Company Name -->
                <t t-if="props.data.company and props.data.company.name">
                    <div class="bff-store-name">
                        <t t-esc="props.data.company.name"/>
                    </div>
                </t>
                <t t-elif="props.data.company_name">
                    <div class="bff-store-name">
                        <t t-esc="props.data.company_name"/>
                    </div>
                </t>

                <!-- Address line -->
                <t t-if="props.data.company and props.data.company.street">
                    <div class="bff-store-info"><t t-esc="props.data.company.street"/></div>
                </t>
                <t t-if="props.data.company and props.data.company.city">
                    <div class="bff-store-info"><t t-esc="props.data.company.city"/></div>
                </t>

                <!-- Phone -->
                <t t-if="props.data.company and props.data.company.phone">
                    <div class="bff-store-info">Telp: <t t-esc="props.data.company.phone"/></div>
                </t>

                <!-- NPWP -->
                <t t-if="props.data.company and props.data.company.vat">
                    <div class="bff-store-info">NPWP: <t t-esc="props.data.company.vat"/></div>
                </t>

                <!-- Transaction ref code -->
                <t t-if="props.data.ref_code">
                    <div class="bff-ref-code"><t t-esc="props.data.ref_code"/></div>
                </t>
            </div>
        </xpath>
    </t>
</templates>
