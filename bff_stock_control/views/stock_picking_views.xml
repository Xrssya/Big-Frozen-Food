<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Stock Picking Form View Inherit: Add Dual Quantity (Box & Pack) -->
    <record id="stock_picking_form_dual_qty" model="ir.ui.view">
        <field name="name">stock.picking.form.dual.qty</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <!-- Insert qty_box column before product_uom_qty in move_ids_without_package list view -->
            <xpath expr="//field[@name='move_ids_without_package']/list/field[@name='product_uom_qty']" position="before">
                <field name="qty_box" string="Jml Box/Kardus" optional="show"/>
            </xpath>

            <!-- Update label string for product_uom_qty for clarity -->
            <xpath expr="//field[@name='move_ids_without_package']/list/field[@name='product_uom_qty']" position="attributes">
                <attribute name="string">Demand (Pack)</attribute>
            </xpath>
        </field>
    </record>
</odoo>
