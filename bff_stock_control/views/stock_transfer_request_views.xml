<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sequence for Stock Transfer Request -->
    <record id="seq_stock_transfer_request" model="ir.sequence">
        <field name="name">Permintaan Restock Darurat</field>
        <field name="code">stock.transfer.request</field>
        <field name="prefix">REQ/%(year)s/%(month)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Form View Stock Transfer Request -->
    <record id="view_stock_transfer_request_form" model="ir.ui.view">
        <field name="name">stock.transfer.request.form</field>
        <field name="model">stock.transfer.request</field>
        <field name="arch" type="xml">
            <form string="Permintaan Restock / Transfer Antar Gudang">
                <header>
                    <button name="action_submit" string="Kirim Pengajuan" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Setujui &amp; Buat Transfer" type="object" class="btn-success" invisible="state != 'submitted'" groups="stock.group_stock_manager"/>
                    <button name="action_return_transit_to_source" string="🔄 Return Transit ke Gudang Asal" type="object" class="btn-warning" invisible="state != 'in_transit'" groups="stock.group_stock_manager" confirm="Apakah Anda yakin ingin membatalkan pengiriman transit dan mengembalikan barang ke Gudang Asal?"/>
                    <button name="action_draft" string="Set ke Draft" type="object" class="btn-secondary" invisible="state != 'cancelled'"/>
                    <button name="action_cancel" string="Batal" type="object" class="btn-secondary" invisible="state in ('done', 'cancelled', 'in_transit')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,in_transit,done,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_out_picking" type="object" class="oe_stat_button" icon="fa-truck" invisible="out_picking_count == 0">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Transfer Keluar</span>
                                <span class="o_stat_value"><field name="out_picking_state" widget="badge"/></span>
                            </div>
                        </button>
                        <button name="action_view_in_picking" type="object" class="oe_stat_button" icon="fa-download" invisible="in_picking_count == 0">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Transfer Masuk</span>
                                <span class="o_stat_value"><field name="in_picking_state" widget="badge"/></span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Informasi Pengajuan">
                            <field name="requested_by_id" readonly="1"/>
                            <field name="request_date" readonly="state != 'draft'"/>
                            <field name="priority" widget="radio" options="{'horizontal': true}" readonly="state != 'draft'"/>
                        </group>
                        <group string="Gudang Pengirim &amp; Penerima">
                            <field name="source_warehouse_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="dest_warehouse_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="source_location_id" readonly="1" groups="base.group_no_one"/>
                            <field name="dest_location_id" readonly="1" groups="base.group_no_one"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Daftar Produk Restock" name="lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="qty_available_source" string="Stok Tersedia (Pengirim)" digits="[16, 0]"/>
                                    <field name="qty_box" string="Jml Box/Kardus" optional="show"/>
                                    <field name="qty_requested" string="Jumlah Diminta (Pack)"/>
                                    <field name="qty_shipped" string="Dikirim (Outbound)" optional="show" readonly="1"/>
                                    <field name="qty_received" string="Diterima (Inbound)" optional="show" readonly="1"/>
                                    <field name="uom_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Alasan &amp; Catatan" name="notes">
                            <field name="notes" placeholder="Tuliskan alasan permintaan restock (contoh: Stok Bakso di toko A habis karena pemesanan besar)..." readonly="state != 'draft'"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Tree View Stock Transfer Request -->
    <record id="view_stock_transfer_request_tree" model="ir.ui.view">
        <field name="name">stock.transfer.request.tree</field>
        <field name="model">stock.transfer.request</field>
        <field name="arch" type="xml">
            <list string="Permintaan Restock / Transfer Antar Gudang" decoration-danger="priority == '2'" decoration-warning="priority == '1'">
                <field name="name"/>
                <field name="request_date"/>
                <field name="requested_by_id"/>
                <field name="source_warehouse_id"/>
                <field name="dest_warehouse_id"/>
                <field name="priority" widget="badge"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'submitted'"
                       decoration-primary="state == 'approved'"
                       decoration-muted="state == 'in_transit'"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Search View Stock Transfer Request -->
    <record id="view_stock_transfer_request_search" model="ir.ui.view">
        <field name="name">stock.transfer.request.search</field>
        <field name="model">stock.transfer.request</field>
        <field name="arch" type="xml">
            <search string="Cari Permintaan Restock">
                <field name="name"/>
                <field name="source_warehouse_id"/>
                <field name="dest_warehouse_id"/>
                <field name="requested_by_id"/>
                <separator/>
                <filter string="🔥 Darurat" name="filter_emergency" domain="[('priority', '=', '2')]"/>
                <filter string="⏳ Menunggu Persetujuan" name="filter_submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="🚚 Dalam Perjalanan" name="filter_in_transit" domain="[('state', '=', 'in_transit')]"/>
                <filter string="📋 Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" domain="[]" context="{'group_by': 'state'}"/>
                    <filter string="Gudang Pengirim" name="group_source_wh" domain="[]" context="{'group_by': 'source_warehouse_id'}"/>
                    <filter string="Gudang Penerima" name="group_dest_wh" domain="[]" context="{'group_by': 'dest_warehouse_id'}"/>
                    <filter string="Prioritas" name="group_priority" domain="[]" context="{'group_by': 'priority'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action Stock Transfer Request -->
    <record id="action_stock_transfer_request" model="ir.actions.act_window">
        <field name="name">Permintaan Restock / Transfer Antar Gudang</field>
        <field name="res_model">stock.transfer.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_stock_transfer_request_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Buat Permintaan Restock / Transfer Antar Gudang Baru!
            </p>
            <p>
                Gunakan fitur ini ketika stok produk frozen food di toko/gudang cabang Anda memerlukan kiriman stok dari Gudang lain.
            </p>
        </field>
    </record>

    <!-- Menu Item in Inventory -> Operations -->
    <menuitem id="menu_stock_transfer_request"
              name="📦 Transfer Antar Gudang"
              parent="stock.menu_stock_warehouse_mgmt"
              action="action_stock_transfer_request"
              sequence="30"/>
</odoo>
