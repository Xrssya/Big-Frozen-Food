<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product Template Search View Inherit for Status Stok Filters -->
    <record id="view_product_template_search_stock_status" model="ir.ui.view">
        <field name="name">product.template.search.stock.status</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='filter_to_sell']" position="after">
                <separator/>
                <filter string="🟢 Stok Cukup (Hijau)" name="filter_stock_available" domain="[('is_storable', '=', True), ('qty_available', '&gt;', 10)]"/>
                <filter string="🟡 Stok Menipis (Kuning)" name="filter_stock_low" domain="[('is_storable', '=', True), ('qty_available', '&gt;', 0), ('qty_available', '&lt;=', 10)]"/>
                <filter string="🔴 Stok Habis / Minus (Merah)" name="filter_stock_empty" domain="[('is_storable', '=', True), ('qty_available', '&lt;=', 0)]"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="Status Stok" name="groupby_stock_status" context="{'group_by': 'stock_status'}"/>
            </xpath>
        </field>
    </record>
</odoo>
