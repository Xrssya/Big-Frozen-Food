<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product Template Kanban View Inherit (Geser Foto ke Kiri & Perbesar Bulatan Status) -->
    <record id="view_product_template_kanban_stock_status_dot" model="ir.ui.view">
        <field name="name">product.template.kanban.stock.status.dot</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="inside">
                <field name="stock_status"/>
                <field name="min_stock_alert_qty"/>
                <field name="is_storable"/>
            </xpath>

            <!-- Geser foto produk ke kiri dengan menambahkan margin kanan agar tidak bertumpuk dengan bulatan status -->
            <xpath expr="//aside" position="attributes">
                <attribute name="class">me-4 pe-1</attribute>
            </xpath>

            <!-- Bulatan Status Stok yang Dibesarkan di Pojok Atas Kanan Box Produk -->
            <xpath expr="//templates//t[@t-name='card']" position="inside">
                <div t-if="record.is_storable.raw_value"
                     class="position-absolute top-0 end-0 m-2 rounded-circle border border-2 border-white"
                     t-att-title="'Status Stok: ' + (record.stock_status.value || '')"
                     t-attf-style="width: 20px; height: 20px; z-index: 10; box-shadow: 0 2px 6px rgba(0,0,0,0.35); background-color: {{ record.stock_status.raw_value == 'empty' ? '#dc3545' : (record.stock_status.raw_value == 'low' ? '#ffc107' : '#28a745') }};">
                </div>
            </xpath>
        </field>
    </record>

    <!-- Product Template Form View Inherit -->
    <record id="view_product_template_form_stock_control" model="ir.ui.view">
        <field name="name">product.template.form.stock.control</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_lots_and_weight']" position="after">
                <group string="Kontrol &amp; Limit Stok (Big Frozen Food)" name="group_stock_control">
                    <field name="min_stock_alert_qty" widget="integer"/>
                    <field name="min_stock_reserve_qty" widget="integer"/>
                    <field name="allow_negative_stock"/>
                    <field name="stock_status" widget="badge"
                           decoration-success="stock_status == 'available'"
                           decoration-warning="stock_status == 'low'"
                           decoration-danger="stock_status == 'empty'"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Product Template Tree View Inherit -->
    <record id="view_product_template_tree_stock_control" model="ir.ui.view">
        <field name="name">product.template.tree.stock.control</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='qty_available']" position="after">
                <field name="min_stock_alert_qty" string="Min Stok" optional="show"/>
                <field name="stock_status" string="Status Stok" widget="badge"
                       decoration-success="stock_status == 'available'"
                       decoration-warning="stock_status == 'low'"
                       decoration-danger="stock_status == 'empty'"
                       optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
