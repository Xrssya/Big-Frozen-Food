<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_bff_stock_opname_form" model="ir.ui.view">
        <field name="name">bff.stock.opname.form</field>
        <field name="model">bff.stock.opname</field>
        <field name="arch" type="xml">
            <form string="Stok Opname Persediaan">
                <header>
                    <button name="action_populate_quants" string="🔄 Ambil Stok Sistem" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_start_counting" string="▶ Mulai Perhitungan Fisik" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_set_physical_equals_system" string="⚡ Set Stok Fisik = Stok Sistem" type="object" class="btn-secondary" invisible="state not in ('draft', 'in_progress')"/>
                    <button name="action_validate" string="✓ Validasi Opname &amp; Adjust Stok" type="object" class="btn-success" invisible="state != 'in_progress'" groups="stock.group_stock_manager"/>
                    <button name="action_reset_to_draft" string="🔄 Set ke Draft" type="object" class="btn-warning" invisible="state not in ('validated', 'cancel')" groups="stock.group_stock_manager" confirm="Apakah Anda yakin ingin mengembalikan dokumen opname ini ke status Draft? Penyesuaian stok yang telah divalidasi akan dikembalikan ke kondisi semula."/>
                    <button name="action_cancel" string="Batalkan Dokumen" type="object" invisible="state in ('validated', 'cancel')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,validated,cancel"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_moves" type="object" class="oe_stat_button" icon="fa-exchange" invisible="move_count == 0">
                            <field name="move_count" widget="statinfo" string="Stock Moves"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Nomor Opname"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Informasi Lokasi &amp; Gudang">
                            <field name="warehouse_id" readonly="state != 'draft'"/>
                            <field name="location_id" readonly="state != 'draft'"/>
                            <field name="category_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                        </group>
                        <group string="Informasi Pelaksanaan &amp; Validasi">
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="user_id" readonly="state != 'draft'"/>
                            <field name="counted_by_id" readonly="state in ('validated', 'cancel')"/>
                            <field name="counted_at" readonly="1"/>
                            <field name="validator_id" readonly="1"/>
                            <field name="date_validated" readonly="1"/>
                        </group>
                    </group>

                    <!-- Ringkasan Statistik -->
                    <group class="o_group">
                        <group string="Ringkasan Opname">
                            <field name="product_count" string="Total Produk"/>
                            <field name="counted_product_count" string="Sudah Dihitung"/>
                            <field name="total_difference_qty" string="Total Selisih"
                                   decoration-danger="total_difference_qty &lt; 0"
                                   decoration-success="total_difference_qty &gt; 0"
                                   decoration-muted="total_difference_qty == 0"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Detail Produk Opname">
                            <field name="line_ids" readonly="state in ('validated', 'cancel')">
                                <list editable="bottom" decoration-danger="has_difference and difference_qty &lt; 0" decoration-success="has_difference and difference_qty &gt; 0" decoration-muted="not is_counted">
                                    <field name="quant_id" column_invisible="True"/>
                                    <field name="product_id" options="{'no_create': True}"/>
                                    <field name="product_code" optional="show"/>
                                    <field name="category_id" optional="hide"/>
                                    <field name="lot_id" domain="[('product_id', '=', product_id)]" options="{'no_create_edit': True}" optional="show"/>
                                    <field name="system_qty"/>
                                    <field name="physical_qty"/>
                                    <field name="difference_qty" readonly="1" force_save="1"/>
                                    <field name="product_uom_id" readonly="1"/>
                                    <field name="is_counted" readonly="1" widget="boolean_toggle"/>
                                    <field name="has_difference" column_invisible="True"/>
                                    <field name="counted_at" optional="hide" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Catatan &amp; Keterangan Audit">
                            <field name="notes" placeholder="Tuliskan catatan hasil pemeriksaan fisik, kondisi barang di freezer, atau kendala opname..." readonly="state in ('validated', 'cancel')"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_bff_stock_opname_tree" model="ir.ui.view">
        <field name="name">bff.stock.opname.list</field>
        <field name="model">bff.stock.opname</field>
        <field name="arch" type="xml">
            <list string="Stok Opname Persediaan">
                <field name="name" decoration-bf="1"/>
                <field name="date"/>
                <field name="warehouse_id"/>
                <field name="location_id"/>
                <field name="user_id"/>
                <field name="counted_by_id" optional="show"/>
                <field name="product_count"/>
                <field name="counted_product_count" optional="show"/>
                <field name="total_difference_qty" decoration-danger="total_difference_qty &lt; 0" decoration-success="total_difference_qty &gt; 0"/>
                <field name="validator_id" optional="show"/>
                <field name="date_validated" optional="show"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'in_progress'" decoration-success="state == 'validated'" decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_bff_stock_opname_search" model="ir.ui.view">
        <field name="name">bff.stock.opname.search</field>
        <field name="model">bff.stock.opname</field>
        <field name="arch" type="xml">
            <search string="Cari Stok Opname">
                <field name="name" string="Nomor Opname"/>
                <field name="warehouse_id"/>
                <field name="location_id"/>
                <field name="user_id"/>
                <field name="category_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Dalam Perhitungan" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Divalidasi" name="validated" domain="[('state', '=', 'validated')]"/>
                <filter string="Dibatalkan" name="cancel" domain="[('state', '=', 'cancel')]"/>
                <separator/>
                <filter string="Ada Selisih Stok" name="has_diff" domain="[('total_difference_qty', '!=', 0)]"/>
                <group expand="0" string="Group By">
                    <filter string="Gudang" name="groupby_warehouse" context="{'group_by': 'warehouse_id'}"/>
                    <filter string="Lokasi" name="groupby_location" context="{'group_by': 'location_id'}"/>
                    <filter string="Status" name="groupby_state" context="{'group_by': 'state'}"/>
                    <filter string="Bulan Opname" name="groupby_date" context="{'group_by': 'date:month'}"/>
                    <filter string="Pembuat Dokumen" name="groupby_user" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action Window -->
    <record id="action_bff_stock_opname" model="ir.actions.act_window">
        <field name="name">Stok Opname Persediaan</field>
        <field name="res_model">bff.stock.opname</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_bff_stock_opname_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Belum ada dokumen Stok Opname.
            </p>
            <p>
                Buat sesi Stok Opname baru untuk memeriksa persediaan fisik di freezer/gudang dan melakukan penyesuaian stok otomatis ke Odoo.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_bff_stock_opname"
              name="Stok Opname"
              parent="stock.menu_stock_warehouse_mgmt"
              action="action_bff_stock_opname"
              sequence="48"/>
</odoo>
