<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_view_buttons_inherit_cicilan" model="ir.ui.view">
        <field name="name">res.partner.view.buttons.inherit.cicilan</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button type="object"
                    class="oe_stat_button"
                    icon="fa-credit-card"
                    name="action_view_partner_installments"
                    invisible="installment_count == 0">
                    <field string="Cicilan Aktif" name="installment_count" widget="statinfo"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
