<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_method_view_form_inherit_cicilan" model="ir.ui.view">
        <field name="name">pos.payment.method.form.inherit.cicilan</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='split_transactions']" position="after">
                <field name="is_cicilan"/>
            </xpath>
        </field>
    </record>

    <record id="pos_payment_method_view_tree_inherit_cicilan" model="ir.ui.view">
        <field name="name">pos.payment.method.list.inherit.cicilan</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="is_cicilan" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
