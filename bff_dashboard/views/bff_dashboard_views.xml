<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Executive Dashboard Client Action (Main / Combined) -->
    <record id="action_bff_dashboard_main" model="ir.actions.client">
        <field name="name">Dashboard</field>
        <field name="tag">bff_dashboard_main</field>
        <field name="target">main</field>
        <field name="context">{'default_mode': 'all'}</field>
    </record>

    <!-- 2. Sales Dashboard Client Action (Penjualan) -->
    <record id="action_bff_dashboard_sales" model="ir.actions.client">
        <field name="name">Dashboard Penjualan</field>
        <field name="tag">bff_dashboard_sales</field>
        <field name="target">main</field>
        <field name="context">{'default_mode': 'sales'}</field>
    </record>

    <!-- 3. Stock & Expiry Dashboard Client Action (Inventaris) -->
    <record id="action_bff_dashboard_stock" model="ir.actions.client">
        <field name="name">Dashboard Stok</field>
        <field name="tag">bff_dashboard_stock</field>
        <field name="target">main</field>
        <field name="context">{'default_mode': 'stock'}</field>
    </record>

    <!-- 4. Purchase Dashboard Client Action (Pembelian) -->
    <record id="action_bff_dashboard_purchase" model="ir.actions.client">
        <field name="name">Dashboard Pembelian</field>
        <field name="tag">bff_dashboard_purchase</field>
        <field name="target">main</field>
        <field name="context">{'default_mode': 'purchase'}</field>
    </record>

    <!-- 5. POS Retail Dashboard Client Action (Point of Sale) -->
    <record id="action_bff_dashboard_pos" model="ir.actions.client">
        <field name="name">POS</field>
        <field name="tag">bff_dashboard_pos</field>
        <field name="target">main</field>
        <field name="context">{'default_mode': 'pos'}</field>
    </record>

    <!-- 6. Stock Valuation Quant Tree View for Cold-Chain Drilldown -->
    <record id="view_bff_stock_quant_tree" model="ir.ui.view">
        <field name="name">bff.stock.quant.tree</field>
        <field name="model">stock.quant</field>
        <field name="arch" type="xml">
            <list string="Nilai Stok Fisik (Cold-Chain)" create="false" edit="false">
                <field name="product_id" string="Produk"/>
                <field name="location_id" string="Lokasi"/>
                <field name="lot_id" string="Lot / Serial" optional="show"/>
                <field name="quantity" string="Kuantitas (Unit)" sum="Total Kuantitas"/>
                <field name="product_uom_id" string="Satuan"/>
                <field name="stock_valuation_amount" string="Nilai Stok (Rp)" sum="Total Nilai Stok"/>
            </list>
        </field>
    </record>

    <record id="action_bff_stock_valuation_quant" model="ir.actions.act_window">
        <field name="name">Nilai Stok Fisik (Cold-Chain)</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_bff_stock_quant_tree"/>
        <field name="domain">[('location_id.usage', '=', 'internal'), ('quantity', '>', 0)]</field>
    </record>


    <!-- ======================================================= -->
    <!-- MENU PLACEMENTS IN RESPECTIVE MODULES                   -->
    <!-- ======================================================= -->

    <!-- Main Executive Dashboard Root App Menu (Sequence=1) -->
    <menuitem id="menu_bff_dashboard_root"
              name="Dashboard"
              action="action_bff_dashboard_main"
              web_icon="bff_dashboard,static/description/icon.png"
              sequence="1"/>

    <!-- Sembunyikan Dashboard Bawaan Odoo (spreadsheet_dashboard) -->
    <menuitem id="spreadsheet_dashboard.spreadsheet_dashboard_menu_root" active="False"/>

    <!-- Dashboard Penjualan in Sales Module (sale.sale_menu_root) -->
    <menuitem id="menu_bff_dashboard_sales_item"
              name="Dashboard Penjualan"
              parent="sale.sale_menu_root"
              action="action_bff_dashboard_sales"
              sequence="-10"/>

    <!-- Dashboard Stok & Kadaluarsa in Stock Module (stock.menu_stock_root) -->
    <menuitem id="menu_bff_dashboard_stock_item"
              name="Dashboard Stok"
              parent="stock.menu_stock_root"
              action="action_bff_dashboard_stock"
              sequence="-10"/>

    <!-- Dashboard Pembelian in Purchase Module (purchase.menu_purchase_root) -->
    <menuitem id="menu_bff_dashboard_purchase_item"
              name="Dashboard Pembelian"
              parent="purchase.menu_purchase_root"
              action="action_bff_dashboard_purchase"
              sequence="-10"/>

    <!-- Dashboard POS Analytics in Point of Sale Module (point_of_sale.menu_point_root) -->
    <menuitem id="menu_bff_dashboard_pos_item"
              name="Dashboard"
              parent="point_of_sale.menu_point_root"
              action="action_bff_dashboard_pos"
              sequence="-10"/>

    <!-- Ubah Nama Menu Dashboard Default Odoo POS Menjadi 'POS' -->
    <record id="point_of_sale.menu_pos_dashboard" model="ir.ui.menu">
        <field name="name">POS</field>
    </record>

</odoo>
