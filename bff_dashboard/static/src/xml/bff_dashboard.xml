<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="bff_dashboard.BffDashboardTemplate">
        <div class="o_bff_dashboard p-4">

            <!-- HEADER BAR -->
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge text-bg-primary fw-bold px-2 py-1 rounded-2" style="font-size:0.7rem;">BIG FROZEN FOOD</span>
                        <span class="live-indicator">
                            <span class="pulse-dot"/>
                            Live Analytics
                        </span>
                    </div>
                    <h2 class="fw-bold mb-0">
                        <t t-if="state.mode === 'sales'">Dashboard Penjualan B2B &amp; POS</t>
                        <t t-elif="state.mode === 'pos'">Dashboard POS Toko Retail</t>
                        <t t-elif="state.mode === 'stock'">Dashboard Stok &amp; FEFO</t>
                        <t t-elif="state.mode === 'purchase'">Dashboard Pembelian</t>
                        <t t-else="">Dashboard Eksekutif</t>
                    </h2>
                </div>

                <div class="d-flex align-items-center flex-wrap gap-3 mt-3 mt-md-0">
                    <!-- Mode Pills -->
                    <div class="bff-pill-group">
                        <button type="button" t-att-class="state.mode === 'all' ? 'btn-pill active' : 'btn-pill'" t-on-click="() => this.changeMode('all')">Semua</button>
                        <button type="button" t-att-class="state.mode === 'sales' ? 'btn-pill active' : 'btn-pill'" t-on-click="() => this.changeMode('sales')">Penjualan</button>
                        <button type="button" t-att-class="state.mode === 'pos' ? 'btn-pill active' : 'btn-pill'" t-on-click="() => this.changeMode('pos')">POS Toko</button>
                        <button type="button" t-att-class="state.mode === 'stock' ? 'btn-pill active' : 'btn-pill'" t-on-click="() => this.changeMode('stock')">Stok &amp; FEFO</button>
                        <button type="button" t-att-class="state.mode === 'purchase' ? 'btn-pill active' : 'btn-pill'" t-on-click="() => this.changeMode('purchase')">Pembelian</button>
                    </div>
                    <!-- Period Pills -->
                    <div class="bff-period-group">
                        <button type="button" t-att-class="state.period === 'month' ? 'btn-period-pill active' : 'btn-period-pill'" t-on-click="() => this.changePeriod('month')">Bulan Ini</button>
                        <button type="button" t-att-class="state.period === '30days' ? 'btn-period-pill active' : 'btn-period-pill'" t-on-click="() => this.changePeriod('30days')">30 Hari</button>
                        <button type="button" t-att-class="state.period === 'year' ? 'btn-period-pill active' : 'btn-period-pill'" t-on-click="() => this.changePeriod('year')">Tahun Ini</button>
                        <button type="button" t-att-class="state.period === 'all' ? 'btn-period-pill active' : 'btn-period-pill'" t-on-click="() => this.changePeriod('all')">Semua</button>
                    </div>
                    <!-- Refresh -->
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-circle" style="width:36px;height:36px;" t-on-click="reloadDashboard" title="Refresh">
                        <i t-att-class="state.loading ? 'fa fa-refresh fa-spin' : 'fa fa-refresh'"/>
                    </button>
                </div>
            </div>

            <!-- LOADING -->
            <t t-if="state.loading">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"/>
                    <p class="mt-3 text-muted">Memuat data dashboard...</p>
                </div>
            </t>

            <t t-else="">
                <!-- KPI CARDS -->
                <div class="row g-3 mb-4">

                    <!-- Standard Sales Revenue Card -->
                    <t t-if="state.mode === 'all' || state.mode === 'sales'">
                        <div class="col-12 col-sm-6 col-xl-3">
                            <div class="bff-card p-3">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="text-muted mb-1" style="font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;">Total Omset Sales</div>
                                        <div class="fw-bold fs-4 text-dark" t-out="formatCurrency(state.data.sales.total_revenue)"/>
                                        <div class="mt-2">
                                            <span class="trend-badge trend-badge-up">
                                                <i class="fa fa-arrow-up me-1"/>Agen &amp; POS
                                            </span>
                                        </div>
                                    </div>
                                    <div class="icon-box icon-box-sales"><i class="fa fa-line-chart"/></div>
                                </div>
                            </div>
                        </div>
                    </t>

                    <!-- Dedicated POS Mode KPI Cards -->
                    <t t-if="state.mode === 'pos'">
                        <!-- POS Card 1: Total POS Omset -->
                        <div class="col-12 col-sm-6 col-xl-3">
                            <div class="bff-card p-3">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="text-muted mb-1" style="font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;">Total Omset POS Toko</div>
                                        <div class="fw-bold fs-4 text-dark" t-out="formatCurrency(state.data.pos.total_revenue)"/>
                                        <div class="mt-2">
                                            <span class="trend-badge trend-badge-up">
                                                <i class="fa fa-shopping-bag me-1"/>Retail Toko
                                            </span>
                                        </div>
                                    </div>
                                    <div class="icon-box icon-box-sales"><i class="fa fa-shopping-bag"/></div>
                                </div>
                            </div>
                        </div>

                        <!-- POS Card 2: Total Transaksi -->
                        <div class="col-12 col-sm-6 col-xl-3">
                            <div class="bff-card p-3">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="text-muted mb-1" style="font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;">Jumlah Transaksi POS</div>
                                        <div class="fw-bold fs-4 text-dark">
                                            <t t-out="state.data.pos.orders_count"/>
                                            <small class="fw-normal text-muted fs-6"> Struk</small>
                                        </div>
                                        <div class="mt-2">
                                            <span class="trend-badge trend-badge-neutral">
                                                <i class="fa fa-ticket me-1"/>Struk Kasir
                                            </span>
                                        </div>
                                    </div>
                                    <div class="icon-box icon-box-stock"><i class="fa fa-ticket"/></div>
                                </div>
                            </div>
                        </div>

                        <!-- POS Card 3: Rata-Rata Keranjang (Basket Size) -->
                        <div class="col-12 col-sm-6 col-xl-3">
                            <div class="bff-card p-3">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="text-muted mb-1" style="font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;">Rata-Rata per Struk</div>
                                        <div class="fw-bold fs-4 text-dark" t-out="formatCurrency(state.data.pos.avg_basket_size)"/>
                                        <div class="mt-2">
                                            <span class="trend-badge trend-badge-neutral">
                                                <i class="fa fa-calculator me-1"/>Basket Size
                                            </span>
                                        </div>
                                    </div>
                                    <div class="icon-box icon-box-warning"><i class="fa fa-calculator"/></div>
                                </div>
                            </div>
                        </div>

                        <!-- POS Card 4: Sesi Kasir Aktif -->
                        <div class="col-12 col-sm-6 col-xl-3">
                            <div class="bff-card p-3">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="text-muted mb-1" style="font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;">Sesi Kasir Aktif</div>
                                        <div class="fw-bold fs-4 text-dark">
                                            <t t-out="state.data.pos.active_sessions_count"/>
                                            <small class="fw-normal text-muted fs-6"> Sesi Open</small>
                                        </div>
                                        <div class="mt-2">
                                            <span class="trend-badge trend-badge-up">
                                                <i class="fa fa-circle text-success me-1"/>Kasir Buka
                                            </span>
                                        </div>
                                    </div>
                                    <div class="icon-box icon-box-purchase"><i class="fa fa-user-circle-o"/></div>
                                </div>
                            </div>
                        </div>
                    </t>

                    <t t-if="state.mode === 'all' || state.mode === 'stock'">
                        <div class="col-12 col-sm-6 col-xl-3">
                            <div class="bff-card p-3">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="text-muted mb-1" style="font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;">Nilai Stok Fisik</div>
                                        <div class="fw-bold fs-4 text-dark" t-out="formatCurrency(state.data.stock.total_valuation)"/>
                                        <div class="mt-2">
                                            <span class="trend-badge trend-badge-neutral">
                                                <i class="fa fa-database me-1"/>Cold-Chain
                                            </span>
                                        </div>
                                    </div>
                                    <div class="icon-box icon-box-stock"><i class="fa fa-cubes"/></div>
                                </div>
                            </div>
                        </div>
                    </t>

                    <t t-if="state.mode === 'all' || state.mode === 'stock'">
                        <div class="col-12 col-sm-6 col-xl-3">
                            <div class="bff-card p-3">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="text-muted mb-1" style="font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;">Stok Menipis</div>
                                        <div class="fw-bold fs-4 text-dark">
                                            <t t-out="state.data.stock.low_stock_count"/>
                                            <small class="fw-normal text-muted fs-6"> Item</small>
                                        </div>
                                        <div class="mt-2">
                                            <span class="trend-badge trend-badge-warn">
                                                <i class="fa fa-warning me-1"/>Reorder Alert
                                            </span>
                                        </div>
                                    </div>
                                    <div class="icon-box icon-box-warning"><i class="fa fa-exclamation-triangle"/></div>
                                </div>
                            </div>
                        </div>
                    </t>

                    <t t-if="state.mode === 'all' || state.mode === 'stock'">
                        <div class="col-12 col-sm-6 col-xl-3">
                            <div class="bff-card p-3">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="text-muted mb-1" style="font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;">Near-Expiry FEFO</div>
                                        <div class="fw-bold fs-4 text-dark">
                                            <t t-out="state.data.stock.near_expiry_count"/>
                                            <small class="fw-normal text-muted fs-6"> Lot</small>
                                        </div>
                                        <div class="mt-2">
                                            <span class="trend-badge trend-badge-warn">
                                                <i class="fa fa-clock-o me-1"/>FEFO H-30
                                            </span>
                                        </div>
                                    </div>
                                    <div class="icon-box icon-box-expiry"><i class="fa fa-calendar-times-o"/></div>
                                </div>
                            </div>
                        </div>
                    </t>

                    <t t-if="state.mode === 'all' || state.mode === 'purchase'">
                        <div class="col-12 col-sm-6 col-xl-3">
                            <div class="bff-card p-3">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="text-muted mb-1" style="font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;">Belanja Supplier</div>
                                        <div class="fw-bold fs-4 text-dark" t-out="formatCurrency(state.data.purchase.monthly_total)"/>
                                        <div class="mt-2">
                                            <span class="trend-badge trend-badge-neutral">
                                                <i class="fa fa-truck me-1"/>PO Supplier
                                            </span>
                                        </div>
                                    </div>
                                    <div class="icon-box icon-box-purchase"><i class="fa fa-shopping-cart"/></div>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>

                <!-- DEDICATED POS SECTION -->
                <t t-if="state.mode === 'pos'">
                    <div class="row g-4 mb-4">
                        <div class="col-12 col-lg-8">
                            <div class="bff-card p-4 h-100">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div>
                                        <h6 class="fw-bold mb-0">Grafik Penjualan POS Toko</h6>
                                        <p class="text-muted mb-0" style="font-size:0.78rem;">Tren omset harian transaksi kasir</p>
                                    </div>
                                </div>
                                <div style="position:relative;height:260px;">
                                    <canvas t-ref="salesChartCanvas"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-4">
                            <div class="bff-card p-4 h-100">
                                <h6 class="fw-bold mb-1">Status Sesi Kasir POS</h6>
                                <p class="text-muted mb-3" style="font-size:0.78rem;">Daftar kasir yang sedang buka</p>
                                <div class="table-responsive">
                                    <table class="table align-middle">
                                        <thead>
                                            <tr>
                                                <th>POS / Kasir</th>
                                                <th class="text-center">Jam Buka</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="state.data.pos.session_list" t-as="sess" t-key="sess.id">
                                                <tr>
                                                    <td>
                                                        <div class="fw-semibold text-dark" t-out="sess.config_name"/>
                                                        <small class="text-muted"><t t-out="sess.user_name"/></small>
                                                    </td>
                                                    <td class="text-center">
                                                        <span class="badge text-bg-success px-2 py-1" t-out="sess.start_at"/>
                                                    </td>
                                                </tr>
                                            </t>
                                            <t t-if="!state.data.pos.session_list.length">
                                                <tr>
                                                    <td colspan="2" class="text-center text-muted py-4">Belum ada sesi kasir yang aktif saat ini.</td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Top 5 POS Products Table -->
                    <div class="bff-card p-4 mb-4">
                        <h6 class="fw-bold mb-1">Top 5 Produk Terlaris POS Toko</h6>
                        <p class="text-muted mb-3" style="font-size:0.78rem;">Ranking produk berdasarkan omset penjualan retail kasir</p>
                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead>
                                    <tr>
                                        <th style="width:55px;" class="text-center">Rank</th>
                                        <th>Produk</th>
                                        <th class="text-end">Qty Terjual</th>
                                        <th class="text-end">Total Omset POS</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.data.pos.top_5_products" t-as="prod" t-key="prod.id">
                                        <tr>
                                            <td class="text-center">
                                                <t t-if="prod_index === 0"><span class="rank-medal rank-1">🥇</span></t>
                                                <t t-elif="prod_index === 1"><span class="rank-medal rank-2">🥈</span></t>
                                                <t t-elif="prod_index === 2"><span class="rank-medal rank-3">🥉</span></t>
                                                <t t-else=""><span class="rank-medal rank-other" t-out="prod_index + 1"/></t>
                                            </td>
                                            <td class="fw-semibold" t-out="prod.name"/>
                                            <td class="text-end fw-bold text-info">
                                                <t t-out="prod.qty"/> <small class="text-muted fw-normal" t-out="prod.uom"/>
                                            </td>
                                            <td class="text-end fw-bold text-success" t-out="formatCurrency(prod.revenue)"/>
                                        </tr>
                                    </t>
                                    <t t-if="!state.data.pos.top_5_products.length">
                                        <tr><td colspan="4" class="text-center text-muted py-4">Belum ada transaksi POS pada periode ini.</td></tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </t>

                <!-- SALES SECTION -->
                <t t-if="state.mode === 'all' || state.mode === 'sales'">
                    <div class="row g-4 mb-4">
                        <div class="col-12 col-lg-7">
                            <div class="bff-card p-4 h-100">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div>
                                        <h6 class="fw-bold mb-0">Grafik Omset Penjualan</h6>
                                        <p class="text-muted mb-0" style="font-size:0.78rem;">Tren harian &amp; bulanan</p>
                                    </div>
                                    <div class="bff-pill-group">
                                        <button type="button" t-att-class="state.salesView === 'daily' ? 'btn-pill active' : 'btn-pill'" t-on-click="() => this.toggleSalesView('daily')">Harian</button>
                                        <button type="button" t-att-class="state.salesView === 'monthly' ? 'btn-pill active' : 'btn-pill'" t-on-click="() => this.toggleSalesView('monthly')">Bulanan</button>
                                    </div>
                                </div>
                                <div style="position:relative;height:260px;">
                                    <canvas t-ref="salesChartCanvas"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-5">
                            <div class="bff-card p-4 h-100">
                                <h6 class="fw-bold mb-1">Channel Penjualan</h6>
                                <p class="text-muted mb-3" style="font-size:0.78rem;">B2B Agen vs POS Retail</p>
                                <div style="position:relative;height:200px;">
                                    <canvas t-ref="channelChartCanvas"/>
                                </div>
                                <div class="d-flex justify-content-around text-center mt-3 pt-3 border-top">
                                    <div>
                                        <div class="text-muted" style="font-size:0.72rem;font-weight:700;text-transform:uppercase;">Agen B2B</div>
                                        <div class="fw-bold text-primary" t-out="formatCurrency(state.data.sales.so_revenue)"/>
                                    </div>
                                    <div class="border-start"/>
                                    <div>
                                        <div class="text-muted" style="font-size:0.72rem;font-weight:700;text-transform:uppercase;">POS Retail</div>
                                        <div class="fw-bold text-info" t-out="formatCurrency(state.data.sales.pos_revenue)"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Top Products Table -->
                    <div class="bff-card p-4 mb-4">
                        <h6 class="fw-bold mb-1">Top 5 Produk Terlaris</h6>
                        <p class="text-muted mb-3" style="font-size:0.78rem;">Ranking berdasarkan omset &amp; volume penjualan</p>
                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead>
                                    <tr>
                                        <th style="width:55px;" class="text-center">Rank</th>
                                        <th>Produk</th>
                                        <th class="text-end">Qty Terjual</th>
                                        <th class="text-end">Total Omset</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.data.sales.top_5_products" t-as="prod" t-key="prod.id">
                                        <tr>
                                            <td class="text-center">
                                                <t t-if="prod_index === 0"><span class="rank-medal rank-1">🥇</span></t>
                                                <t t-elif="prod_index === 1"><span class="rank-medal rank-2">🥈</span></t>
                                                <t t-elif="prod_index === 2"><span class="rank-medal rank-3">🥉</span></t>
                                                <t t-else=""><span class="rank-medal rank-other" t-out="prod_index + 1"/></t>
                                            </td>
                                            <td class="fw-semibold" t-out="prod.name"/>
                                            <td class="text-end fw-bold text-primary">
                                                <t t-out="prod.qty"/> <small class="text-muted fw-normal" t-out="prod.uom"/>
                                            </td>
                                            <td class="text-end fw-bold text-success" t-out="formatCurrency(prod.revenue)"/>
                                        </tr>
                                    </t>
                                    <t t-if="!state.data.sales.top_5_products.length">
                                        <tr><td colspan="4" class="text-center text-muted py-4">Belum ada data penjualan.</td></tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </t>

                <!-- STOCK SECTION -->
                <t t-if="state.mode === 'all' || state.mode === 'stock'">
                    <div class="row g-4 mb-4">
                        <div class="col-12 col-lg-6">
                            <div class="bff-card p-4 h-100">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div>
                                        <h6 class="fw-bold mb-0">Stok Menipis</h6>
                                        <p class="text-muted mb-0" style="font-size:0.78rem;">Di bawah batas minimum reorder</p>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-link text-primary p-0 fw-semibold text-decoration-none" t-on-click="openLowStockAction">
                                        Lihat Semua <i class="fa fa-arrow-right ms-1"/>
                                    </button>
                                </div>
                                <div class="table-responsive">
                                    <table class="table align-middle">
                                        <thead>
                                            <tr>
                                                <th>Produk</th>
                                                <th class="text-end">Stok</th>
                                                <th class="text-end">Min Alert</th>
                                                <th class="text-center">Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="state.data.stock.low_stock_items" t-as="item" t-key="item.id">
                                                <tr>
                                                    <td class="fw-semibold" t-out="item.name"/>
                                                    <td class="text-end fw-bold text-danger"><t t-out="item.qty_available"/> <small class="text-muted fw-normal" t-out="item.uom"/></td>
                                                    <td class="text-end text-muted"><t t-out="item.min_alert_qty"/></td>
                                                    <td class="text-center"><span class="badge-pill-danger">MENIPIS</span></td>
                                                </tr>
                                            </t>
                                            <t t-if="!state.data.stock.low_stock_items.length">
                                                <tr><td colspan="4" class="text-center text-success py-4"><i class="fa fa-check-circle me-1"/>Semua stok aman.</td></tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6">
                            <div class="bff-card p-4 h-100">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div>
                                        <h6 class="fw-bold mb-0">FEFO Near-Expiry Watchlist</h6>
                                        <p class="text-muted mb-0" style="font-size:0.78rem;">Lot mendekati kadaluarsa (H-30)</p>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-link text-primary p-0 fw-semibold text-decoration-none" t-on-click="openExpiryAction">
                                        Lihat Semua <i class="fa fa-arrow-right ms-1"/>
                                    </button>
                                </div>
                                <div class="table-responsive">
                                    <table class="table align-middle">
                                        <thead>
                                            <tr>
                                                <th>Produk / Lot</th>
                                                <th class="text-center">Tgl Expiry</th>
                                                <th class="text-center">Sisa Hari</th>
                                                <th class="text-center">Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="state.data.stock.near_expiry_items" t-as="lot" t-key="lot.id">
                                                <tr>
                                                    <td>
                                                        <div class="fw-semibold" t-out="lot.product_name"/>
                                                        <small class="text-muted">Lot: <t t-out="lot.lot_name"/></small>
                                                    </td>
                                                    <td class="text-center text-muted" t-out="lot.expiration_date"/>
                                                    <td class="text-center fw-bold">
                                                        <t t-if="lot.status === 'EXPIRED'">
                                                            <span class="text-danger">Expired</span>
                                                        </t>
                                                        <t t-else="">
                                                            <span class="text-warning"><t t-out="lot.days_left"/> hr</span>
                                                        </t>
                                                    </td>
                                                    <td class="text-center">
                                                        <t t-if="lot.status === 'EXPIRED'"><span class="badge-pill-danger">EXPIRED</span></t>
                                                        <t t-elif="lot.status === 'CRITICAL'"><span class="badge-pill-danger">KRITIS</span></t>
                                                        <t t-else=""><span class="badge-pill-warning">WASPADA</span></t>
                                                    </td>
                                                </tr>
                                            </t>
                                            <t t-if="!state.data.stock.near_expiry_items.length">
                                                <tr><td colspan="4" class="text-center text-success py-4"><i class="fa fa-check-circle me-1"/>Tidak ada lot mendekati kadaluarsa.</td></tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>

                <!-- PURCHASE SECTION -->
                <t t-if="state.mode === 'all' || state.mode === 'purchase'">
                    <div class="row g-4 mb-4">
                        <div class="col-12 col-lg-7">
                            <div class="bff-card p-4 h-100">
                                <h6 class="fw-bold mb-1">Grafik Belanja per Supplier</h6>
                                <p class="text-muted mb-3" style="font-size:0.78rem;">Distribusi alokasi belanja ke vendor</p>
                                <div style="position:relative;height:260px;">
                                    <canvas t-ref="supplierChartCanvas"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-5">
                            <div class="bff-card p-4 h-100">
                                <h6 class="fw-bold mb-1">Rekap Belanja Supplier</h6>
                                <p class="text-muted mb-3" style="font-size:0.78rem;">Total nominal PO per vendor</p>
                                <div class="table-responsive">
                                    <table class="table align-middle">
                                        <thead>
                                            <tr>
                                                <th>Supplier</th>
                                                <th class="text-center">PO</th>
                                                <th class="text-end">Total (Rp)</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="state.data.purchase.supplier_breakdown" t-as="supp" t-key="supp_index">
                                                <tr>
                                                    <td class="fw-semibold" t-out="supp.supplier"/>
                                                    <td class="text-center"><span class="badge text-bg-light" t-out="supp.po_count"/></td>
                                                    <td class="text-end fw-bold text-indigo" t-out="formatCurrency(supp.total)"/>
                                                </tr>
                                            </t>
                                            <t t-if="!state.data.purchase.supplier_breakdown.length">
                                                <tr><td colspan="3" class="text-center text-muted py-4">Belum ada data pembelian.</td></tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>

            </t>
        </div>
    </t>
</templates>
