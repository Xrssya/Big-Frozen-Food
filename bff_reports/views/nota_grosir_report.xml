<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ═══════════════════════════════════════════════════════════════
             TEMPLATE: Nota Grosir (Printer Besar / A4) + Stock Dus / Pack
             Inherits web.external_layout, renders full wholesale invoice
        ═══════════════════════════════════════════════════════════════ -->
        <template id="bff_nota_grosir_document">
            <t t-call="web.external_layout">
                <t t-set="o" t-value="o.with_context(lang=lang)"/>
                <div class="page">

                    <!-- ── Header Section ────────────────────────────────── -->
                    <div class="row mb-3">
                        <div class="col-6">
                            <h2 class="mt-4" style="font-weight: 800; font-size: 22px; border-bottom: 3px solid #1a1a1a; padding-bottom: 6px;">
                                <t t-if="o.move_type == 'out_invoice'">NOTA GROSIR / FAKTUR PENJUALAN</t>
                                <t t-elif="o.move_type == 'out_refund'">NOTA KREDIT</t>
                                <t t-else="">NOTA GROSIR</t>
                            </h2>
                        </div>
                        <div class="col-6 text-end">
                            <table class="table table-sm table-borderless" style="font-size: 13px;">
                                <tr>
                                    <td class="text-end pe-1"><strong>No. Nota:</strong></td>
                                    <td class="text-start" style="min-width:140px;">
                                        <span t-field="o.name" style="font-weight:700; font-size:15px;"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-end pe-1"><strong>Tanggal:</strong></td>
                                    <td class="text-start">
                                        <span t-field="o.invoice_date"
                                              t-options='{"widget":"date", "format":"dd MMMM yyyy"}'/>
                                    </td>
                                </tr>
                                <tr t-if="o.invoice_date_due and o.move_type == 'out_invoice'">
                                    <td class="text-end pe-1"><strong>Jatuh Tempo:</strong></td>
                                    <td class="text-start">
                                        <span t-field="o.invoice_date_due"
                                              t-options='{"widget":"date", "format":"dd MMMM yyyy"}'/>
                                    </td>
                                </tr>
                                <tr t-if="o.invoice_origin">
                                    <td class="text-end pe-1"><strong>No. SO:</strong></td>
                                    <td class="text-start"><span t-field="o.invoice_origin"/></td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <!-- ── Pelanggan / Pengirim ──────────────────────────── -->
                    <div class="row mb-3">
                        <div class="col-6">
                            <strong style="text-transform:uppercase; font-size:11px; letter-spacing:0.6px; color:#666;">
                                Kepada Yth.
                            </strong>
                            <div t-field="o.partner_id"
                                 t-options='{"widget":"contact","fields":["name","address","phone","mobile"],"no_marker":True}'
                                 style="font-size:13px;"/>
                        </div>
                        <div class="col-6" t-if="o.partner_id.vat or o.partner_shipping_id">
                            <t t-if="o.partner_id.vat">
                                <p style="font-size:13px;">
                                    <strong>NPWP:</strong> <span t-field="o.partner_id.vat"/>
                                </p>
                            </t>
                            <t t-if="o.partner_shipping_id and o.partner_shipping_id != o.partner_id">
                                <strong style="font-size:11px; color:#666;">ALAMAT PENGIRIMAN:</strong>
                                <div t-field="o.partner_shipping_id"
                                     t-options='{"widget":"contact","fields":["name","address"],"no_marker":True}'
                                     style="font-size:13px;"/>
                            </t>
                        </div>
                    </div>

                    <!-- ── Tabel Produk ──────────────────────────────────── -->
                    <table class="table table-sm o_main_table mt-2" name="invoice_line_table"
                           style="font-size: 13px;">
                        <thead>
                            <tr style="background-color: #1a1a1a; color: #ffffff;">
                                <th class="text-center" style="width:4%; padding:7px 5px;">No.</th>
                                <th style="width:40%; padding:7px 8px;">Nama Produk</th>
                                <th class="text-center" style="width:7%; padding:7px 5px;">Qty</th>
                                <th class="text-center" style="width:16%; padding:7px 5px; background:#2c3e50;">
                                    📦 Stok Dus / Pack
                                </th>
                                <th class="text-end" style="width:13%; padding:7px 8px;">Harga Satuan</th>
                                <th class="text-center" style="width:7%; padding:7px 5px;">Diskon</th>
                                <th class="text-end" style="width:13%; padding:7px 8px;">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="row_num" t-value="0"/>
                            <t t-foreach="o.invoice_line_ids" t-as="line">
                                <t t-if="not line.display_type or line.display_type == 'product'">
                                    <t t-set="row_num" t-value="row_num + 1"/>
                                    <tr t-att-style="'background-color:' + ('#f8f9fa' if row_num % 2 == 0 else '#ffffff') + ';'">
                                        <td class="text-center align-middle" style="color:#888;">
                                            <t t-out="row_num"/>
                                        </td>
                                        <td class="align-middle">
                                            <strong t-field="line.product_id"
                                                    t-options='{"widget":"many2one_barcode"}'
                                                    style="display:none;"/>
                                            <span t-field="line.name" style="font-weight:600;"/>
                                            <t t-if="line.product_id.default_code">
                                                <br/>
                                                <small style="color:#888; font-size:11px;">[<t t-out="line.product_id.default_code"/>]</small>
                                            </t>
                                        </td>
                                        <td class="text-center align-middle">
                                            <span t-field="line.quantity"
                                                  t-options='{"widget":"float","precision":0}'/>
                                            <small t-if="line.product_uom_id" style="color:#666;">
                                                <br/><t t-out="line.product_uom_id.name"/>
                                            </small>
                                        </td>
                                        <!-- ╔══════════════════╗
                                             ║  DUS / PACK COL  ║
                                             ╚══════════════════╝ -->
                                        <td class="text-center align-middle"
                                            style="background-color:#eef7ff; font-weight:700; color:#0369a1; letter-spacing:0.2px; border-left:2px solid #bae6fd; border-right:2px solid #bae6fd;">
                                            <span t-field="line.qty_dus_pack_str"
                                                  style="font-size:13px;"/>
                                        </td>
                                        <td class="text-end align-middle">
                                            <span t-field="line.price_unit"
                                                  t-options='{"widget":"monetary","display_currency":o.currency_id}'/>
                                        </td>
                                        <td class="text-center align-middle">
                                            <t t-if="line.discount">
                                                <span t-field="line.discount"
                                                      t-options='{"widget":"float","precision":1}'/>%
                                            </t>
                                            <t t-else="">-</t>
                                        </td>
                                        <td class="text-end align-middle" style="font-weight:600;">
                                            <span t-field="line.price_subtotal"
                                                  t-options='{"widget":"monetary","display_currency":o.currency_id}'/>
                                        </td>
                                    </tr>
                                </t>
                                <!-- Section header (notes / subtitles) -->
                                <t t-elif="line.display_type == 'line_section'">
                                    <tr>
                                        <td colspan="7" style="font-weight:700; background-color:#f0f0f0; padding:5px 8px; font-size:12px; border-top:1px solid #ccc;">
                                            <span t-field="line.name"/>
                                        </td>
                                    </tr>
                                </t>
                                <t t-elif="line.display_type == 'line_note'">
                                    <tr>
                                        <td colspan="7" style="font-style:italic; color:#666; font-size:11px; padding:3px 8px;">
                                            <span t-field="line.name"/>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>

                    <!-- ── Summary: Total Volume Grosir ─────────────────── -->
                    <div class="row mt-2">
                        <div class="col-7">
                            <!-- Total Dus/Pack Summary Box -->
                            <div style="background: linear-gradient(135deg, #0369a1 0%, #0284c7 100%);
                                        color: white; border-radius: 8px; padding: 12px 16px;
                                        font-size: 13px; display: inline-block; min-width: 240px;">
                                <div style="font-size:11px; opacity:0.85; letter-spacing:0.5px; text-transform:uppercase;">
                                    Total Volume Barang Grosir
                                </div>
                                <div style="font-size:18px; font-weight:800; margin-top:4px;">
                                    📦 <span t-field="o.total_dus_pack_str"/>
                                </div>
                            </div>
                            <!-- Catatan / Narasi -->
                            <t t-if="o.narration">
                                <div class="mt-3" style="font-size:12px; color:#555;">
                                    <strong>Catatan:</strong>
                                    <div t-field="o.narration" style="margin-top:4px;"/>
                                </div>
                            </t>
                        </div>
                        <div class="col-5">
                            <!-- Totals Table -->
                            <table class="table table-sm table-borderless" style="font-size:13px;">
                                <tr>
                                    <td class="text-start"><strong>Subtotal</strong></td>
                                    <td class="text-end">
                                        <span t-field="o.amount_untaxed"
                                              t-options='{"widget":"monetary","display_currency":o.currency_id}'/>
                                    </td>
                                </tr>
                                <t t-foreach="o.amount_by_group" t-as="amount_by_group">
                                    <tr>
                                        <td class="text-start">
                                            <t t-out="amount_by_group[0]"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-att-class="'tax'"
                                                  t-out="formatLang(amount_by_group[1], currency_obj=o.currency_id)"/>
                                        </td>
                                    </tr>
                                </t>
                                <tr style="border-top: 2px solid #1a1a1a; background-color: #1a1a1a; color: white;">
                                    <td class="text-start" style="font-weight:800; font-size:15px; padding: 8px 12px;">
                                        TOTAL
                                    </td>
                                    <td class="text-end" style="font-weight:800; font-size:15px; padding: 8px 12px;">
                                        <span t-field="o.amount_total"
                                              t-options='{"widget":"monetary","display_currency":o.currency_id}'/>
                                    </td>
                                </tr>
                                <t t-if="o.payment_state == 'paid'">
                                    <tr>
                                        <td colspan="2" class="text-center" style="color: green; font-weight:700; padding:6px;">
                                            ✅ LUNAS
                                        </td>
                                    </tr>
                                </t>
                                <t t-elif="o.payment_state in ('partial', 'not_paid')">
                                    <tr>
                                        <td class="text-start" style="color:#b45309;">Sisa Tagihan</td>
                                        <td class="text-end" style="color:#b45309; font-weight:700;">
                                            <span t-field="o.amount_residual"
                                                  t-options='{"widget":"monetary","display_currency":o.currency_id}'/>
                                        </td>
                                    </tr>
                                </t>
                            </table>
                        </div>
                    </div>

                    <!-- ── TTD / Tanda Tangan ────────────────────────────── -->
                    <div class="row mt-4" style="font-size:12px;">
                        <div class="col-4 text-center">
                            <div style="border-top:1px solid #888; margin-top:60px; padding-top:5px;">
                                Diterima Oleh
                            </div>
                        </div>
                        <div class="col-4 text-center">
                            <div style="border-top:1px solid #888; margin-top:60px; padding-top:5px;">
                                Hormat Kami,
                            </div>
                        </div>
                        <div class="col-4 text-center">
                            <div style="border-top:1px solid #888; margin-top:60px; padding-top:5px;">
                                Pengirim / Driver
                            </div>
                        </div>
                    </div>

                </div>
            </t>
        </template>

        <!-- Wrapper template (standard Odoo pattern for multi-record printing) -->
        <template id="bff_nota_grosir">
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="o.partner_id.lang or 'id_ID'"/>
                <t t-call="bff_reports.bff_nota_grosir_document"/>
            </t>
        </template>

        <!-- ═══════════════════════════════════════════════════════════════
             ACTION: ir.actions.report untuk Nota Grosir
        ═══════════════════════════════════════════════════════════════ -->
        <record id="action_report_nota_grosir" model="ir.actions.report">
            <field name="name">Nota Grosir (Printer Besar)</field>
            <field name="model">account.move</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">bff_reports.bff_nota_grosir</field>
            <field name="report_file">bff_reports.bff_nota_grosir</field>
            <field name="print_report_name">'NOTA_GROSIR_' + (object.name or '').replace('/', '_')</field>
            <field name="binding_model_id" ref="account.model_account_move"/>
            <field name="binding_type">report</field>
            <field name="groups_id" eval="[(4, ref('account.group_account_invoice'))]"/>
            <field name="paperformat_id" ref="base.paperformat_euro"/>
        </record>

    </data>
</odoo>
