            <field name="action" ref="action_bff_sales_report_wizard"/>
            <field name="name">Laporan</field>
        </record>

        <!-- Override Menu Transaksi POS Toko dengan View Terkelompok Provinsi & Cabang -->
        <record id="point_of_sale.menu_point_of_sale" model="ir.ui.menu">
            <field name="action" ref="action_bff_pos_order_grouped"/>
            <field name="name">Transaksi POS Toko</field>
        </record>

        <!-- ============================================================
             3. INVENTARIS: KLIK MENU LAPORAN LANGSUNG MUNCUL WIZARD
             ============================================================ -->
        <record id="stock.menu_product_stock" model="ir.ui.menu">
