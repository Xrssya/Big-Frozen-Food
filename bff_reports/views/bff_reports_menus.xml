        </record>
        <record id="sale.menu_reporting_customer" model="ir.ui.menu">
            <field name="active">False</field>
        </record>

        <!-- Pasang Aksi Wizard Langsung pada Top Menu Navbar 'Laporan' Penjualan -->
        <record id="sale.menu_sale_report" model="ir.ui.menu">
            <field name="action" ref="action_bff_sales_report_wizard"/>
            <field name="name">Laporan</field>
        </record>

        <!-- ============================================================
             2. POINT OF SALE (POS): KLIK MENU LAPORAN LANGSUNG MUNCUL WIZARD
             ============================================================ -->
        <record id="point_of_sale.menu_report_pos_order_all" model="ir.ui.menu">
            <field name="active">False</field>
