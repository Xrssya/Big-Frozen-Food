            <field name="name">Laporan</field>
        </record>

        <!-- ============================================================
             4. PEMBELIAN: KLIK MENU LAPORAN LANGSUNG MUNCUL WIZARD
             ============================================================ -->
        <record id="purchase.purchase_report" model="ir.ui.menu">
