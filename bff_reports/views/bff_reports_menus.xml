             5. PENAGIHAN / KEUANGAN: KLIK MENU LAPORAN LANGSUNG MUNCUL WIZARD
             ============================================================ -->
        <record id="account.account_reports_management_menu" model="ir.ui.menu">
            <field name="active">False</field>
        </record>

        <record id="account.menu_finance_reports" model="ir.ui.menu">
            <field name="action" ref="action_bff_finance_report_wizard"/>
            <field name="name">Laporan</field>
        </record>

