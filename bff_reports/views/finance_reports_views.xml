<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Action: Laporan Umur Piutang Pelanggan & Agen -->
        <record id="action_bff_report_receivables" model="ir.actions.act_window">
            <field name="name">Laporan Piutang Pelanggan &amp; Agen</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">list,kanban,pivot,graph,form</field>
            <field name="domain">[('move_type', '=', 'out_invoice'), ('state', '=', 'posted'), ('payment_state', 'in', ['not_paid', 'partial'])]</field>
            <field name="context">{'default_move_type': 'out_invoice', 'group_by': ['partner_id']}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Daftar Tagihan Piutang Penjualan Grosir ke Agen &amp; Reseller yang Belum Lunas.
                </p>
            </field>
        </record>

        <!-- Action: Laporan Umur Hutang Pemasok / Supplier -->
        <record id="action_bff_report_payables" model="ir.actions.act_window">
            <field name="name">Laporan Tagihan Hutang Pemasok / Supplier</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">list,kanban,pivot,graph,form</field>
            <field name="domain">[('move_type', '=', 'in_invoice'), ('state', '=', 'posted'), ('payment_state', 'in', ['not_paid', 'partial'])]</field>
            <field name="context">{'default_move_type': 'in_invoice', 'group_by': ['partner_id']}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Daftar Tagihan Hutang Pembelian Barang Beku dari Supplier yang Belum Dibayar.
                </p>
            </field>
        </record>

        <!-- Action: Laporan Rekonsiliasi Kas & Sesi POS Kasir -->
        <record id="action_bff_report_pos_sessions" model="ir.actions.act_window">
            <field name="name">Laporan Rekonsiliasi Kas Sesi POS Kasir</field>
            <field name="res_model">pos.session</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="context">{'group_by': ['config_id', 'state']}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Laporan Pembukaan, Penutupan, dan Uang Kas di Laci Kasir Sesi POS Toko.
                </p>
            </field>
        </record>

    </data>
</odoo>
