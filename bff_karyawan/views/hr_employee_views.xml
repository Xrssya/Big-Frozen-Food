<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Inherit Form View Karyawan -->
        <record id="view_employee_form_inherit_bff" model="ir.ui.view">
            <field name="name">hr.employee.form.inherit.bff</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='job_id']" position="after">
                    <field name="bff_role" widget="radio" options="{'horizontal': true}"/>
                </xpath>

                <xpath expr="//page[@name='public']" position="inside">
                    <group string="Operasional &amp; Tugas Big Frozen Food">
                        <group string="Role &amp; Shift Kerja">
                            <field name="bff_role"/>
                            <field name="shift_schedule"/>
                        </group>
                        <group string="Penugasan Gudang">
                            <field name="assigned_warehouse_id"/>
                        </group>
                    </group>
                    <group string="Tanggung Jawab &amp; Detail Pendataan Barang">
                        <field name="warehouse_responsibilities" placeholder="Contoh: Mendata stock barang datang, cek tanggal kadaluarsa nugget/sosis di freezer, input penyesuaian stock..."/>
                    </group>
                    <group string="Konfigurasi Komisi &amp; Bonus Kasir (Big Frozen Food)" invisible="bff_role not in ['kasir', 'cashier']">
                        <group>
                            <field name="commission_rate_percent"/>
                            <field name="clearance_bonus_percent"/>
                        </group>
                        <group>
                            <field name="total_commission_earned" widget="monetary"/>
                        </group>
                    </group>
                </xpath>

                <xpath expr="//page[@name='hr_settings']" position="inside">
                    <group string="Kredensial Login Akun (Khusus Admin / Pemilik)">
                        <label for="account_password" string="Password Akun Login"/>
                        <div class="o_row">
                            <field name="account_password" password="true" invisible="show_password" placeholder="Ketik / ubah password login Odoo di sini..."/>
                            <field name="account_password" invisible="not show_password" placeholder="Ketik / ubah password login Odoo di sini..."/>
                            <field name="show_password" widget="boolean_toggle" class="oe_inline"/>
                            <span class="text-muted ms-2">👁️ Perlihatkan Password</span>
                        </div>
                    </group>
                </xpath>
            </field>
        </record>

        <!-- Inherit Tree View Karyawan -->
        <record id="view_employee_tree_inherit_bff" model="ir.ui.view">
            <field name="name">hr.employee.tree.inherit.bff</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='job_id']" position="after">
                    <field name="bff_role" widget="badge" decoration-success="bff_role in ['kepala_toko', 'asisten_kepala_toko', 'manager']" decoration-info="bff_role in ['kasir', 'cashier']" decoration-warning="bff_role in ['kepala_gudang', 'warehouse']"/>
                    <field name="shift_schedule" optional="show"/>
                    <field name="assigned_warehouse_id" optional="show"/>
                </xpath>
            </field>
        </record>

        <!-- Inherit Filter Search View -->
        <record id="view_employee_filter_inherit_bff" model="ir.ui.view">
            <field name="name">hr.employee.filter.inherit.bff</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='group_job']" position="after">
                    <filter string="Role: Kepala Toko" name="filter_role_kepala_toko" domain="[('bff_role', 'in', ['kepala_toko', 'manager'])]"/>
                    <filter string="Role: Asisten Kepala Toko" name="filter_role_asisten_kepala_toko" domain="[('bff_role', '=', 'asisten_kepala_toko')]"/>
                    <filter string="Role: Kasir" name="filter_role_kasir" domain="[('bff_role', 'in', ['kasir', 'cashier'])]"/>
                    <filter string="Role: Kepala Gudang" name="filter_role_kepala_gudang" domain="[('bff_role', 'in', ['kepala_gudang', 'warehouse'])]"/>
                    <separator/>
                    <filter string="Role Operasional" name="group_bff_role" context="{'group_by': 'bff_role'}"/>
                    <filter string="Gudang Penugasan" name="group_assigned_warehouse" context="{'group_by': 'assigned_warehouse_id'}"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
