<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Action untuk Karyawan Kasir -->
        <record id="action_bff_karyawan_cashier" model="ir.actions.act_window">
            <field name="name">Karyawan Kasir</field>
            <field name="res_model">hr.employee</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="domain">[('bff_role', '=', 'kasir')]</field>
            <field name="context">{'default_bff_role': 'kasir'}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Belum ada data Karyawan Kasir.
                </p>
                <p>
                    Karyawan dengan role Kasir bertugas menangani transaksi POS dan layanan pembayaran kasir.
                </p>
            </field>
        </record>

        <!-- Action untuk Orang Gudang -->
        <record id="action_bff_karyawan_warehouse" model="ir.actions.act_window">
            <field name="name">Orang / Staf Gudang</field>
            <field name="res_model">hr.employee</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="domain">[('bff_role', '=', 'kepala_gudang')]</field>
            <field name="context">{'default_bff_role': 'kepala_gudang'}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Belum ada data Staf Gudang.
                </p>
                <p>
                    Orang Gudang bertugas mendata barang yang ada di gudang, kelola stock opname, penerimaan barang, dan mutasi barang.
                </p>
            </field>
        </record>

        <!-- Sembunyikan Sub-menu Navbar yang tidak diperlukan / duplikat -->
        <menuitem id="hr.menu_hr_department_tree" active="False"/>
        <menuitem id="hr.menu_hr_employee_payroll" active="False"/>

        <!-- Batasi Akses Menu Utama (Sidebar) Agar Kasir Hanya Melihat POS, Kontak, dan Diskusi -->
        <record id="bff_dashboard.menu_bff_dashboard_root" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [
                ref('bff_karyawan.group_bff_kepala_toko'),
                ref('bff_karyawan.group_bff_asisten_kepala_toko'),
                ref('bff_karyawan.group_bff_kepala_gudang'),
                ref('base.group_system')
            ])]"/>
        </record>

        <record id="sale.sale_menu_root" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [
                ref('sales_team.group_sale_salesman'),
                ref('base.group_system')
            ])]"/>
        </record>

        <record id="base.menu_management" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [
                ref('base.group_system')
            ])]"/>
        </record>

        <record id="hr.menu_hr_root" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [
                ref('hr.group_hr_user'),
                ref('bff_karyawan.group_bff_kepala_toko'),
                ref('base.group_system')
            ])]"/>
        </record>

    </data>
</odoo>
