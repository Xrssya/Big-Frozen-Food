<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Action untuk Karyawan Kasir -->
        <record id="action_bff_karyawan_cashier" model="ir.actions.act_window">
            <field name="name">Karyawan Kasir</field>
            <field name="res_model">hr.employee</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="domain">[('bff_role', '=', 'cashier')]</field>
            <field name="context">{'default_bff_role': 'cashier'}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Belum ada data Karyawan Kasir.
                </p>
                <p>
                    Karyawan dengan role Kasir bertugas menangani transaksi POS dan layanan pembayaran kasir.
                </p>
            </field>
        </record>

        <!-- Action untuk Orang Gudang -->
        <record id="action_bff_karyawan_warehouse" model="ir.actions.act_window">
            <field name="name">Orang / Staf Gudang</field>
            <field name="res_model">hr.employee</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="domain">[('bff_role', '=', 'warehouse')]</field>
            <field name="context">{'default_bff_role': 'warehouse'}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Belum ada data Staf Gudang.
                </p>
                <p>
                    Orang Gudang bertugas mendata barang yang ada di gudang, kelola stock opname, penerimaan barang, dan mutasi barang.
                </p>
            </field>
        </record>

        <!-- Sembunyikan Sub-menu Navbar yang tidak diperlukan / duplikat -->
        <menuitem id="hr.menu_hr_department_tree" active="False"/>
        <menuitem id="hr.menu_hr_employee_payroll" active="False"/>
        <menuitem id="menu_bff_karyawan_cashier" active="False"/>
        <menuitem id="menu_bff_karyawan_warehouse" active="False"/>

    </data>
</odoo>
