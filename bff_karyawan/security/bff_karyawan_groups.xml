<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Kategori Keamanan Utama Big Frozen Food -->
        <record id="category_bff_management" model="ir.module.category">
            <field name="name">Big Frozen Food Operational Roles</field>
            <field name="description">Manajemen Hak Akses dan Role Operasional Karyawan Big Frozen Food</field>
            <field name="sequence">20</field>
        </record>

        <!-- Role 1: Kepala Toko -->
        <record id="group_bff_kepala_toko" model="res.groups">
            <field name="name">Kepala Toko</field>
            <field name="category_id" ref="category_bff_management"/>
            <field name="comment">Role Kepala Toko: Akses penuh (Administrator / Manager) ke seluruh modul operasional toko, penjualan, POS, pembelian, gudang, penagihan, dan karyawan.</field>
            <field name="implied_ids" eval="[
                (4, ref('sales_team.group_sale_manager')),
                (4, ref('point_of_sale.group_pos_manager')),
                (4, ref('stock.group_stock_manager')),
                (4, ref('purchase.group_purchase_manager')),
                (4, ref('account.group_account_manager')),
                (4, ref('hr.group_hr_user'))
            ]"/>
        </record>

        <!-- Role 2: Asisten Kepala Toko (Hak Akses Sama persis dengan Kepala Toko) -->
        <record id="group_bff_asisten_kepala_toko" model="res.groups">
            <field name="name">Asisten Kepala Toko</field>
            <field name="category_id" ref="category_bff_management"/>
            <field name="comment">Role Asisten Kepala Toko: Hak akses penuh sama seperti Kepala Toko untuk pengelolaan operasional harian toko, POS, stok, pembelian, dan laporan.</field>
            <field name="implied_ids" eval="[
                (4, ref('sales_team.group_sale_manager')),
                (4, ref('point_of_sale.group_pos_manager')),
                (4, ref('stock.group_stock_manager')),
                (4, ref('purchase.group_purchase_manager')),
                (4, ref('account.group_account_manager')),
                (4, ref('hr.group_hr_user'))
            ]"/>
        </record>

        <!-- Role 3: Kasir -->
        <record id="group_bff_cashier" model="res.groups">
            <field name="name">Kasir</field>
            <field name="category_id" ref="category_bff_management"/>
            <field name="comment">Role Kasir: Memiliki akses ke Modul Diskusi, Dashboard, Penjualan, POS (Point of Sale), dan Pembelian.</field>
            <field name="implied_ids" eval="[
                (4, ref('sales_team.group_sale_salesman')),
                (4, ref('point_of_sale.group_pos_user')),
                (4, ref('purchase.group_purchase_user')),
                (4, ref('hr.group_hr_user'))
            ]"/>
        </record>

        <!-- Role 4: Kepala Gudang -->
        <record id="group_bff_kepala_gudang" model="res.groups">
            <field name="name">Kepala Gudang</field>
            <field name="category_id" ref="category_bff_management"/>
            <field name="comment">Role Kepala Gudang: Memiliki akses ke Modul Diskusi, Pembelian, dan Inventaris/Stok.</field>
            <field name="implied_ids" eval="[
                (4, ref('stock.group_stock_manager')),
                (4, ref('purchase.group_purchase_user')),
                (4, ref('hr.group_hr_user'))
            ]"/>
        </record>

        <!-- Legacy alias for group_bff_warehouse to prevent XML ID deletion errors -->
        <record id="group_bff_warehouse" model="res.groups">
            <field name="name">Kepala Gudang (Legacy)</field>
            <field name="category_id" ref="category_bff_management"/>
            <field name="comment">Alias untuk kompatibilitas data lama Kepala Gudang.</field>
            <field name="implied_ids" eval="[
                (4, ref('stock.group_stock_manager')),
                (4, ref('purchase.group_purchase_user')),
                (4, ref('hr.group_hr_user'))
            ]"/>
        </record>

    </data>
</odoo>
